# Copy to .env and adjust. Every setting can also be passed as a CLI flag.

# --- Model ---------------------------------------------------------------
REACT_MCP_MODEL=qwen3.5:9b
REACT_MCP_OLLAMA_HOST=http://localhost:11434
REACT_MCP_TEMPERATURE=0.1
REACT_MCP_NUM_CTX=8192
REACT_MCP_KEEP_ALIVE=10m
# Set true for thinking models (qwen3.5). Off keeps ReAct output parseable.
REACT_MCP_THINK=false
REACT_MCP_REQUEST_TIMEOUT=180

# --- Agent ---------------------------------------------------------------
REACT_MCP_MAX_STEPS=8
REACT_MCP_MAX_PARSE_RETRIES=2
REACT_MCP_MAX_OBSERVATION_CHARS=2000
# Bounded Q/A memory injected into follow-up prompts
REACT_MCP_MEMORY_TURNS=6
REACT_MCP_MEMORY_CHARS=4000
# Ask for MCP elicitation approval before write_file (set false to auto-approve)
REACT_MCP_REQUIRE_WRITE_APPROVAL=true

# --- MCP transport -------------------------------------------------------
# stdio (default, local subprocess) or http (streamable HTTP server)
REACT_MCP_TRANSPORT=stdio
REACT_MCP_SERVER_URL=http://127.0.0.1:8000/mcp

# --- Web (free web_fetch / web_search) ------------------------------------
REACT_MCP_WEB_FETCH_ENABLED=true
REACT_MCP_WEB_FETCH_TIMEOUT=15
REACT_MCP_WEB_FETCH_MAX_BYTES=500000
REACT_MCP_WEB_FETCH_MAX_CHARS=20000
REACT_MCP_WEB_SEARCH_LIMIT=10
# REACT_MCP_WEB_USER_AGENT=react-mcp/0.1 (+learning project)

# --- Paths ---------------------------------------------------------------
# REACT_MCP_WORKSPACE_DIR=./data/workspace
# REACT_MCP_NOTES_DIR=./data/notes
# REACT_MCP_SESSION_DIR=./data/sessions
REACT_MCP_TRACE_DIR=./traces

# --- Observability -------------------------------------------------------
REACT_MCP_LOG_LEVEL=INFO
# none | console | otlp
REACT_MCP_OTEL=none
REACT_MCP_OTLP_ENDPOINT=http://localhost:4317
